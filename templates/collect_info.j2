
<html>
<head>
<title> Systems Infrastructure </title>
</head>

<body>
{% for sys in groups["cisco"] %}
# Generating Information for {{ hostvars[sys].inventory_hostname }}<br/>
<h4>

  Current	  = {{ sys }}<br/>
  Host		  = {{ hostvars[sys].inventory_hostname }}<br/>
  IP		  = {{ hostvars[sys].ansible_facts['network_resources']['l3_interfaces'][0]['ipv4'][0]['address'] }} <br/>
  Net API         = {{ hostvars[sys].ansible_facts['net_api'] }}<br/>
  Hostname        = {{ hostvars[sys].ansible_facts['net_hostname'] }}<br/>
  IOS Type        = {{ hostvars[sys].ansible_facts['net_iostype'] }}<br/>
  Model           = {{ hostvars[sys].ansible_facts['net_model'] }}<br/>
  Python Version  = {{ hostvars[sys].ansible_facts['net_python_version'] }}<br/>
  Serial Number   = {{ hostvars[sys].ansible_facts['net_serialnum'] }}<br/>
  Net System      = {{ hostvars[sys].ansible_facts['net_system'] }}<br/>
  Net Version     = {{ hostvars[sys].ansible_facts['net_version'] }}<br/>
  Free Memory     = {{ hostvars[sys].ansible_facts['net_filesystems_info']['bootflash:']['spacefree_kb'] }} KB<br/>
  Total Memory    = {{ hostvars[sys].ansible_facts['net_filesystems_info']['bootflash:']['spacetotal_kb'] }}KB <br/>
  acls            = {{ hostvars[sys].ansible_facts['network_resources']['acls'] }}<br/>
  HSRP Interfaces = {{ hostvars[sys].ansible_facts['network_resources']['hsrp_interfaces'] }}<br/>

<br/><br/><br/><br/>

{% endfor %}
</h4>
</body>
</html>
